# rDock docking server for EasyDock (--program server).
# rDock (CBDD/rDock, LGPL-3.0) is built from source at a pinned commit in a build stage; upstream's `make test`
# gates the build. Runtime: Ubuntu 24.04 with the distribution's Python, RDKit and Open Babel (receptor preparation).
#
#   apptainer build rdock.sif rdock_server.def
#   apptainer run rdock.sif help

Bootstrap: docker
From: ubuntu:24.04
Stage: build

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        make g++ libpopt-dev libpopt0 git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

    RDOCK_REPO=https://github.com/CBDD/rDock
    RDOCK_SHA=ee5226da575306d2b321473a94ff4491e591b347
    mkdir -p /src/rDock && cd /src/rDock
    git init -q && git fetch -q --depth 1 "$RDOCK_REPO" "$RDOCK_SHA" && git checkout -q FETCH_HEAD
    test "$(git rev-parse HEAD)" = "$RDOCK_SHA"

    # build_lib first: upstream's `build` target runs build_lib and build_bin as parallel sub-makes, so with -j a
    # binary can link against a half-built libRbt.so. RUNPATH $ORIGIN/../lib: the binaries find the library from
    # any prefix.
    set -- RBT_VERSION="v25.02.$(echo "$RDOCK_SHA" | cut -c1-7)" CXX_EXTRA_FLAGS='-Wl,-rpath,\$$ORIGIN/../lib'
    make -j"$(nproc)" "$@" build_lib
    make -j"$(nproc)" "$@"
    make test
    make install PREFIX=/opt/rdock RBT_ROOT=/opt/rdock
    printf 'repo %s\ncommit %s\n' "$RDOCK_REPO" "$RDOCK_SHA" > /opt/rdock/SOURCE


Bootstrap: docker
From: ubuntu:24.04
Stage: final

%setup
    # bind point used on some HPC systems (XALT); harmless elsewhere
    mkdir -p ${APPTAINER_ROOTFS}/apps/all/XALT/3.0.2
    mkdir -p ${APPTAINER_ROOTFS}/opt/rdock

%files from build
    /opt/rdock /opt/rdock

%files
    rdock_server.py /opt/rdock/rdock_server.py
    rdock_prepare_receptor.py /opt/rdock/rdock_prepare_receptor.py

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-rdkit python3-numpy openbabel libpopt0 \
    && rm -rf /var/lib/apt/lists/*

%environment
    export RBT_ROOT=/opt/rdock
    export PATH=/opt/rdock/bin:$PATH
    export LD_LIBRARY_PATH=/opt/rdock/lib

%runscript
    case "$1" in
        server)
            shift
            exec python3 /opt/rdock/rdock_server.py "$@"
            ;;
        prepare)
            shift
            exec python3 /opt/rdock/rdock_prepare_receptor.py "$@"
            ;;
        help)
            echo "Usage: apptainer run rdock.sif <command>"
            echo "  server            JSON Lines docking server for easydock --program server"
            echo "  prepare ...       prepare a receptor: -p protein_H.pdb (-l ref.sdf | --center X Y Z) -o DIR"
            echo "  rbdock|rbcavity   the rDock programs; any other command is executed as given"
            ;;
        *)
            exec "$@"
            ;;
    esac

%test
    rbdock 2>&1 | grep -q 'Executable' || exit 1
    rbcavity 2>&1 | grep -q 'Executable' || exit 1
    obabel -V
    python3 -c "import rdkit; print('rdkit', rdkit.__version__)"
